# Copy to .env and fill in ONE provider key.
LLM_PROVIDER=anthropic          # anthropic | openai | cloudflare
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cloudflare Workers AI (free tier ~10k neurons/day): dashboard > AI > Workers AI > API token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# TURN_MODEL=@cf/meta/llama-3.2-3b-instruct   # smarter but slower: @cf/qwen/qwen3-30b-a3b-fp8
# BRIEF_MODEL=@cf/openai/gpt-oss-120b

# Sarvam: enables Indian-accent speech-to-text, natural TTS voice, and (if present) the fast reply model.
SARVAM_KEY=
# SARVAM_SPEAKER=simran_en_customer   # SARVAM_PACE=1.05   SARVAM_STT_MODE=transcribe|codemix

# Gemini free keys (rotate on rate limits): GEMINI_API_KEY_1, _2, _3 ...
# GEMINI_API_KEY_1=

# Roles can mix providers: TURN_* = spoken reply, TRACK_* = background slot tracking, BRIEF_* = final summary
# TRACK_PROVIDER=sarvam  TRACK_MODEL=sarvam-105b   # faster (2-3s) but more conservative than the Cloudflare 70B default

# Browserless (renders JavaScript-built forms the plain reader can't see). Optional: only used when cheaper methods find nothing.
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://production-sfo.browserless.io

# Optional overrides. Leave commented to use sensible defaults per provider.
# TURN_MODEL=claude-haiku-4-5-20251001
# BRIEF_MODEL=claude-sonnet-5-5
# For OpenAI use e.g. TURN_MODEL=gpt-4o-mini  BRIEF_MODEL=gpt-4o

PORT=3000
